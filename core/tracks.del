import "../main.del";

Number MAX_TRACKS: 12;

// recStart and recFrames are working copies, trackStart and trackFrames are always current
playervar Number focusedTrack;
playervar Number[] trackStart;
playervar Number[] trackFrames;
playervar Hero[] trackHero;

globalvar Number[] TRACK_IDS!;

Number TrackStart(Number t, Player p = local): p.trackStart[t];
Number TrackFrames(Number t, Player p = local): p.trackFrames[t];
Number TrackEnd(Number t, Player p = local): TrackStart(t, p) + TrackFrames(t, p);
Number TrackCount(): trackFrames.Filter(f => f > 0).Length;

// trim mode keeps the focused track's frames from trimStart until trimEnd, so playback stays between its brackets. cut only once confirmed,
// the trim handles come back after
playervar Boolean trimming!;
playervar Number trimStartWas!;
playervar Number trimEndWas!;
Number TRIM_MAX_LOAD: 125; // server load % the cut waits under between chunks, below the import's so a long cut doesnt stutter the server

// a track's brackets as drawn, the focused track's trim while trimming
Number MarkerStart(Number t, Player p = local): p.trimming && t == p.focusedTrack ? p.trimStart : TrackStart(t, p);
Number MarkerEnd(Number t, Player p = local): p.trimming && t == p.focusedTrack ? p.trimEnd : TrackEnd(t, p);

Boolean TrimChanged(Player p = player): p.trimStart != Max(p.recStart, 0) || p.trimEnd != p.recStart + p.recFrames;

// what can be clicked in trim mode: playback, Delete Track and the trim button
Boolean TrimAllows(Number | Ctrl id): id <= Ctrl.NextFrame || [Ctrl.Track, Ctrl.Trim, Ctrl.Loop].Contains(id);

void EndTrim() playervar "track - end trim"
{
    trimming = false;
    trimStart = trimStartWas;
    trimEnd = trimEndWas;
    UpdateTimelineFrames(); // fits the timeline to a cut, and the playhead to the trim handles
}

void LoadTrack(in Number t)
{
    recStart = trackStart[t];
    recFrames = trackFrames[t];
}
// a track slid before frame 0 counts its whole length, so it can always slide back
void UpdateTimelineFrames() playervar "track - update timeline frames"
{
    timelineFrames = SortedArray(TRACK_IDS.Map(t => TrackFrames(t, player) + Max(TrackStart(t, player), 0)), Curr()).Last;
    trimStart = Clamp(trimStart, 0, timelineFrames);
    trimEnd = Clamp(trimEnd, trimStart, timelineFrames);
    currFrame = Clamp(currFrame, trimStart, trimEnd);
}

void SelectTrack(Number t!) playervar "track - select track"
{
    if (t == focusedTrack)
        return;

    // an armed retake belongs to the track it was armed on
    if (recordArmed && punchFrame != WHOLE_TAKE)
        recordArmed = false;

    // playback keeps going, with "Play all tracks" off the previous track holds where it was
    if (playbackActive)
        trackHold[focusedTrack] = currFrame;

    focusedTrack = t;
    trackLabelsFresh = false;
    LoadTrack(t);
}

void DeleteTrack(Number t!) playervar "track - delete track"
{
    tickK = t; // read through the plain tickK, nothing below uses it
    StopAll();
    DestroyTrackBot(tickK);
    ClearTrack(tickK);
    trackStart[tickK] = 0;
    trackFrames[tickK] = 0;
    trackLabelsFresh = false;
    trackHidden[tickK] = false;
    if (trackClipboard == tickK + 1)
        trackClipboard = 0;

    if (tickK == focusedTrack)
    {
        recStart = 0;
        recFrames = 0;
    }

    UpdateTimelineFrames(); // StopAll ended firstPerson's playback, "firstPerson detach" lets go once the timeline closes
}

// the copied track (trackClipboard) into empty slot t, which is focused after. the copied track is in tickK and t in tickJ after the budget check
void PasteTrack(Number t!) playervar "track - paste"
{
    tickK = trackClipboard - 1;
    trackClipboard = 0;
    trackLabelsFresh = false;
    if (recording || tracksBusy || trackFrames[tickK] == 0) // take and export also use recTake
        return;

    tickJ = trackFrames[tickK];
    for (tickI = 0; tickI < MAX_TRACKS; tickI++)
        tickJ += trackFrames[tickI];

    if (tickJ > MAX_TOTAL_SAMPLES)
    {
        SmallMessage(player, "Not enough budget to allow pasting!");
        return;
    }

    tickJ = t;
    StopAll();
    SelectTrack(tickJ);
    LoadTrack(tickK);
    trackStart[tickJ] = recStart;
    trackFrames[tickJ] = recFrames;
    trackHero[tickJ] = trackHero[tickK];
    trackTeam[tickJ] = trackTeam[tickK];
    trackHidden[tickJ] = false; // a hidden empty slot would give a copy without a bot

    LoadTrackStage(tickK);
    ClearTrack(tickJ);
    AppendTrackStage(tickJ);
    recTake = [];
    SpawnIdleTrackBot(tickJ);
}

// cuts the focused track down to trimStart until trimEnd and ends trim mode. a cut at the start shifts every chunk. its first frame on
// the timeline as the start cuts nothing, not even a part slid before frame 0
void TrimTrack() playervar "track - trim"
{
    StopAll();

    tracksBusy = true; // track is staged in recTake over a few ticks

    Number k! = trimStart > Max(recStart, 0) ? trimStart - recStart : 0; // samples cut from the start
    Number q! = Floor(k / CHUNK_SIZE);
    Number r! = k % CHUNK_SIZE;
    Number n! = trimEnd - recStart - k; // samples kept

    // chunk i takes the rest of chunk q + i and the start of the next, only reading chunks after i
    // the last one's next chunk can be past the stored ones, the outer Slice drops what that reads. with no cut at the start only the last chunk changes
    LoadTrackStage(focusedTrack);
    for (Number i! = k ? 0 : Floor(n / CHUNK_SIZE); i * CHUNK_SIZE < n; i++)
    {
        tickI = q + i; // plain copies, the write repeats them for each Sample field
        tickJ = r;
        tickK = n - i * CHUNK_SIZE;
        recTake[i] = (recTake[tickI].Slice(tickJ, CHUNK_SIZE) + recTake[tickI + 1].Slice(0, tickJ)).Slice(0, tickK);

        // writing copies the track
        MinWait();
        if (ServerLoad() > TRIM_MAX_LOAD)
            WaitUntil(ServerLoad() < TRIM_MAX_LOAD, 2);
    }
    recTake = recTake.Slice(0, Ceil(n / CHUNK_SIZE));
    ClearTrack(focusedTrack);
    AppendTrackStage(focusedTrack);
    recTake = [];

    trackStart[focusedTrack] = recStart + k;
    trackFrames[focusedTrack] = n;
    LoadTrack(focusedTrack);
    trackLabelsFresh = false;
    trackBot[focusedTrack].botWinC = -2; // changed starts alone doesnt reload a window, and the samples moved
    botWinC = -2; // FirstPerson's window
    tracksBusy = false;
    EndTrim();
}

void DeleteAllTracks() playervar "track - delete all tracks"
{
    for (tickJ = 0; tickJ < MAX_TRACKS; tickJ++) // DeleteTrack uses tickK
        DeleteTrack(tickJ);
}
