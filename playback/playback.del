import "../main.del";

enum Snap
{
    None,
    Idle,
    Busy    // ability in use
}

playervar Number playClock!;     // Time() frame 0 is at
// the frame playClock is at. bots lead from it, their own Time() is a tick ahead of the currFrame they see
playervar Number playClockFrame;
// what bots take off currFrame: the loop's length over a seamless loop's last LOOP_LEAD frames, 0 otherwise
playervar Number playLoopShift!;
// CORRECT_LEAD, plus the ~2 ticks a moving bot takes to see the owner and be released. a teleport shows 7-8 ticks late, so the jump can still be a tick off
Number LOOP_LEAD: CORRECT_LEAD + 2;

// bots lead into the start before the wrap, so the playhead doesn't wait there
Boolean SeamlessLoop(): CanLoop() && trimEnd - trimStart > LOOP_LEAD * 2 && !firstPerson;

// frames come from the time like recording does, a tick skipped under load moves the playhead on by more than 1
// clock is set once and not added to every tick, the rounding of each add made the playhead stall or jump a frame
// "play start snap" sets playClock CORRECT_LEAD frames back, so the playhead waits that many ticks while the bots' forced positions
// lead in (BotClockFrame). anything else that moves the playhead (even during playback) also sets playClock
rule: "play"
Event.OngoingPlayer
if (playMode == PlayMode.Play)
if (currFrame < trimEnd)
{
    while (playMode == PlayMode.Play && currFrame < trimEnd)
    {
        playClockFrame = Near((Time() - playClock) / delta);
        currFrame = Max(currFrame, Min(playClockFrame, trimEnd));
        tickI = SeamlessLoop() && currFrame > trimEnd - LOOP_LEAD ? trimEnd - trimStart + 1 : 0;
        if (tickI != playLoopShift)
            playLoopShift = tickI;
        MinWait();
    }
    // not at the wrap, "playback range end" clears it in the tick it moves the playhead
    if (playMode != PlayMode.Play)
        playLoopShift = 0;
    LoopIfConditionIsTrue();
}

// playback that reached the end of its range, doesnt matter how the playhead got there
rule: "playback range end"
Event.OngoingPlayer
if (playMode >= PlayMode.Play)
if (playMode == PlayMode.Rewind ? currFrame <= trimStart : currFrame >= trimEnd)
{
    if (playMode == PlayMode.Play && CanLoop())
    {
        // otherwise the playhead waits CORRECT_LEAD ticks while the bots lead in
        tickI = SeamlessLoop() ? 0 : CORRECT_LEAD;
        currFrame = trimStart;
        playLoopShift = 0;
        playClock = Time() - (trimStart - tickI) * delta; // "play" moves on from here
        playClockFrame = trimStart - tickI;
    }
    else
    {
        if (playMode != PlayMode.Rewind)
        {
            orbiting = false;
            FirstPersonDetach();
        }
        StopAll();
    }
}

Number SNAP_MAX:    125; // 2s, longer abilities just play from the playhead
Number SNAP_MARGIN: 4;

Boolean TrackPlays(Number t): EntityExists(trackBot[t]) || (firstPerson && t == botTrack); // owner has a bot

playervar Snap snapState;
playervar Boolean[] snapIgnore; // track busy for the entire snap window (e.g. soldier sprint)

// track t at frame f into snapState, read from the track's storage
void SampleState(Number t!, Number f!) playervar "playback - sample state"
{
    Number s! = f - TrackStart(t, player);
    if (!TrackPlays(t) || s < 0 || s >= TrackFrames(t, player))
    {
        snapState = Snap.None;
        return;
    }
    ReadTrackSample(t, s);
    snapState = readCtrl.Y % Bit.Ground >= Bit.UsingAb1 ? Snap.Busy : Snap.Idle; // any ability in use
}

// snapState is busy if a track that isnt ignored has an ability in use at f, otherwise None
void CheckTracksBusy(Number f!) playervar "playback - check busy tracks"
{
    snapState = Snap.None;
    for (Number t! = 0; t < MAX_TRACKS && snapState != Snap.Busy; t++)
    {
        if (!snapIgnore[t])
            SampleState(t, f);
    }
        

    if (snapState == Snap.Idle)
        snapState = Snap.None;
}

rule: "play start snap"
Event.OngoingPlayer
if (playMode == PlayMode.Starting)
{
    if (!snapRestart)
        trackHold = TRACK_IDS.Map(t => currFrame);

    Number chosen! = currFrame;
    Number f! = chosen;
    Number lowest! = Max(trimStart, chosen - SNAP_MAX);

    snapIgnore = [];
    for (Number t! = 0; t < MAX_TRACKS; t++)
    {
        Boolean steady! = true;
        // a track outside the window has no state in it, scanning it would read the whole window and would wait for nothing
        if (TrackPlays(t) && TrackStart(t, player) <= chosen && TrackEnd(t, player) > lowest)
        {
            for (Number i! = chosen; i >= lowest && steady; i--)
            {
                SampleState(t, i);
                if (snapState == Snap.Idle)
                    steady = false;

                if (i % 40 == 0)
                    MinWait();
            }
        }
        snapIgnore[t] = steady;
    }

    CheckTracksBusy(f);
    while (snapState == Snap.Busy && f > lowest)
    {
        f--;
        CheckTracksBusy(f);

        if (f % 20 == 0)
            MinWait();
    }

    // only snap to a frame without any ability use, otherwise play from the chosen frame
    if (playMode == PlayMode.Starting && currFrame == chosen && f != chosen && snapState == Snap.None)
    {
        CheckTracksBusy(Max(trimStart, f - SNAP_MARGIN));

        if (snapState == Snap.None)
            f = Max(trimStart, f - SNAP_MARGIN);

        currFrame = f;
    }

    if (playMode == PlayMode.Starting)
    {
        if (!snapRestart)
            trackHold = TRACK_IDS.Map(t => currFrame);

        playClock = Time() - (currFrame - CORRECT_LEAD) * delta; // the playhead waits CORRECT_LEAD ticks, see "play"
        playClockFrame = currFrame - CORRECT_LEAD;
        playLoopShift = 0;
        playMode = PlayMode.Play;
    }
    snapRestart = false;
}

rule: "fast forward / rewind loop"
Event.OngoingPlayer
if (playMode >= PlayMode.Rewind)
if (playMode == PlayMode.Rewind ? currFrame > trimStart : currFrame < trimEnd)
{
    currFrame = Clamp(currFrame + (playMode == PlayMode.Forward ? framesToSkip : -framesToSkip), trimStart, trimEnd);
    MinWait();
    LoopIfConditionIsTrue();
}
