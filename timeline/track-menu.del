import "../main.del";

Number TRACK_MENU_X:           0.9;  // the row labels' center, the buttons sit left of it
Number TRACK_MENU_TOP_Y:       0.65;
Number TRACK_MENU_SPACING:     0.10;
Number TRACK_SLOT_HIT_WIDTH:   1.40;
Number TRACK_TEAM_X:           TRACK_MENU_X - 2.30;
Number TRACK_COPY_X:           TRACK_MENU_X - 1.95;
Number TRACK_HIDE_X:           TRACK_MENU_X - 1.60;
Number TRACK_DELETE_X:         TRACK_MENU_X - 1.24;
Number TRACK_BTN_HALF_W:       0.17; // at most half the buttons spacing, so the hitboxes dont overlap
Number TRACK_ACTIONS_X:        TRACK_MENU_X - 1.755; // Team/Copy/Hide/Delete text center
Number TRACK_DELETE_ALL_ROW: MAX_TRACKS + 0.5;
Number TRACK_BUDGET_Y:       -0.80; // centered on screen, not with the menu

// <FG> tag colors of the Team/Copy/Hide/Delete text: hover (OPT_HOVER_COLOR), white, red, gray
String HEX_HOVER: "44BAFFFF";
String HEX_WHITE: "FFFFFFFF";
String HEX_RED:   "FF0000FF";
String HEX_GRAY:  "808080FF";

playervar Number[] trackMenuTexts;
playervar String[] trackLabels;
playervar String[] trackActions;     // the Team, Copy, Hide and Delete buttons of each row, one text colored with <FG> tags
playervar Boolean trackLabelsFresh;  // set false wherever a track's length, hero, hidden state, the focus or the copied track changes
playervar Number trackLabelsHover!;  // hovered and confirmId the action strings were built for
playervar Number trackLabelsConfirm!;
playervar Number trackClipboard!;    // the copied track + 1, an empty row's Paste button pastes it. 0 when nothing is copied

// a hovered or confirmed id as the action strings show it, hovering anything else (but Delete All) doesnt rebuild them
Number ActionHit(Number id): IsInRange(id, HIT_TEAM, HIT_COPY + MAX_TRACKS - 1) ? id : Ctrl.None;

// the row labels are built here, a formatted string in a text takes seconds to show.
// the Team/Copy/Hide/Delete strings also follow the hover and confirmation while the menu is open. loop counts with tickI, no wait before the end
rule: "track menu labels"
Event.OngoingPlayer
if (trackMenuOpen)
if (!trackLabelsFresh || ActionHit(hovered) != trackLabelsHover || ActionHit(confirmId) != trackLabelsConfirm)
{
    if (!trackLabelsFresh)
    {
        trackLabelsFresh = true;
        tickJ = 0; // the recording budget used
        for (tickI = 0; tickI < MAX_TRACKS; tickI++)
        {
            tickK = trackFrames[tickI];
            FrameText();
            trackLabels[tickI] = <"<0>Track <1>   <2>",
                focusedTrack == tickI ? IconString(Icon.ArrowRight) + " " : "",
                tickI + 1,
                trackFrames[tickI] > 0
                    ? <"<0> <1> long, <2> frames", HeroIconString(trackHero[tickI]), frameText, trackFrames[tickI]>
                    : "Empty">;
            tickJ += trackFrames[tickI];
        }

        tickK = tickJ;
        FrameText();
        trackLabels[MAX_TRACKS] = <"Budget: <0> / 10:00.00 (all tracks)", frameText>; // MAX_TOTAL_SAMPLES
    }

    trackLabelsHover = ActionHit(hovered);
    trackLabelsConfirm = ActionHit(confirmId);

    for (tickI = 0; tickI < MAX_TRACKS; tickI++)
        trackActions[tickI] = <"<0>FG<8>><9><2><0>FG<1>><7><2><0>FG<3>><4><2><0>FG<5>><6>", // this is disgusting
            txCharacter,
            trackFrames[tickI] == 0 && trackClipboard == 0
                ? HEX_GRAY
                : trackClipboard == tickI + 1 || hovered == HIT_COPY + tickI 
                                                    ? HEX_HOVER 
                                                    : HEX_WHITE,
            "         ",
            hovered == HIT_HIDE + tickI ? HEX_HOVER : HEX_WHITE,
            trackHidden[tickI] ? "Show" : "Hide",
            trackFrames[tickI] == 0 ? HEX_GRAY : confirmId == HIT_DELETE + tickI ? HEX_RED : hovered == HIT_DELETE + tickI ? HEX_HOVER : HEX_WHITE,
            confirmId == HIT_DELETE + tickI ? "Delete?" : "Delete",
            trackFrames[tickI] == 0 && trackClipboard > 0 ? "Paste" : "Copy",
            hovered == HIT_TEAM + tickI ? HEX_HOVER : trackTeam[tickI] == Side.Enemy ? HEX_RED : HEX_WHITE,
            trackTeam[tickI] == Side.Enemy ? "Enemy" : "Ally">;

    MinWait();
    LoopIfConditionIsTrue();
}

// the texts exist while the menu is open
rule: "track menu"
Event.OngoingPlayer
if (trackMenuOpen)
{
    trackLabelsFresh = false; // not kept up to date while the menu is closed
    trackMenuTexts = [];
    Wait(0.032); // wait so "cursor on top" makes the cursor first

    for (Number i! = 0; i < MAX_TRACKS; i++)
    {
        if (!trackMenuOpen)
            break;

        WaitUntil(ServerLoad() < 225, 99999);

        CreateInWorldText(
            VisibleTo:      player,
            Header:         local.trackLabels[Once(i)],
            Position:       RenderPosOf(TRACK_MENU_X, TRACK_MENU_TOP_Y - (Once(i)) * TRACK_MENU_SPACING),
            Scale:          1.5,
            TextColor:      IsHovered(Once(HIT_TRACK + i)) ? OPT_HOVER_COLOR
                                : local.focusedTrack == Once(i)
                                    ? Color.White
                                    : Color.Gray,
            Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
            Clipping:       Clipping.DoNotClip,
            Spectators:     Spectators.VisibleNever);
        trackMenuTexts += LastTextID();

        // Team, Copy, Hide and Delete
        CreateInWorldText(
            VisibleTo:      player,
            Header:         local.trackActions[Once(i)],
            Position:       RenderPosOf(TRACK_ACTIONS_X, TRACK_MENU_TOP_Y - (Once(i)) * TRACK_MENU_SPACING),
            Scale:          1.5,
            TextColor:      Color.White,
            Reevaluation:   InworldTextRev.VisibleToPositionAndString,
            Clipping:       Clipping.DoNotClip,
            Spectators:     Spectators.VisibleNever);
        trackMenuTexts += LastTextID();

        MinWait();
    }

    CreateInWorldText(
        VisibleTo:      player,
        Header:         local.confirmId == HIT_DELETE_ALL ? "Confirm Delete All?" : "Delete All Tracks",
        Position:       RenderPosOf(TRACK_MENU_X, TRACK_MENU_TOP_Y - TRACK_DELETE_ALL_ROW * TRACK_MENU_SPACING),
        Scale:          1.5,
        TextColor:      local.confirmId == HIT_DELETE_ALL
                            ? Color.Red
                            : IsHovered(HIT_DELETE_ALL)
                                ? OPT_HOVER_COLOR
                                : Color.White,
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);
    trackMenuTexts += LastTextID();

    CreateInWorldText(
        VisibleTo:      player,
        Header:         local.trackLabels[MAX_TRACKS],
        Position:       RenderPosOf(0, TRACK_BUDGET_Y),
        Scale:          1.2,
        TextColor:      Color.White,
        Reevaluation:   InworldTextRev.VisibleToPositionAndString,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);
    trackMenuTexts += LastTextID();
    CreateCursor();

    WaitUntil(!trackMenuOpen, 99999);

    DestroyTexts(trackMenuTexts);
    LoopIfConditionIsTrue();
}

void TrackMenuClick(in Number id)
{
    if (id < HIT_TEAM)
    {
        trackMenuOpen = false;
        async! SelectTrack(id - HIT_TRACK);
    }
    else if (id < HIT_DELETE_ALL)
    {
        async! ToggleTrackTeam(id - HIT_TEAM);
    }
    else if (id >= HIT_COPY)
    {
        if (trackFrames[id - HIT_COPY] > 0)
        {
            trackClipboard = trackClipboard == id - HIT_COPY + 1 ? 0 : id - HIT_COPY + 1;
            trackLabelsFresh = false;
        }
        else if (trackClipboard > 0)
            async! PasteTrack(id - HIT_COPY);
    }
    else if (id >= HIT_HIDE && id < HIT_DELETE)
    {
        async! ToggleTrackHidden(id - HIT_HIDE);
    }
    // first click asks for confirmation
    else if (confirmId != id)
    {
        confirmId = id;
    }
    else
    {
        confirmId = Ctrl.None;
        if (id == HIT_DELETE_ALL)
            async! DeleteAllTracks();
        else
            async! DeleteTrack(id - HIT_DELETE);
    }
}

