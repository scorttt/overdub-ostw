import "../main.del";

// non-clickable items, the order of TIMELINE_UI_Y_POS
enum Ui
{
    CurrFrame,
    ProgressBar,
    Seeker,
    Handles,
    HandleTime,
    FrameMult,
    TimeElapsed,
    TrackEnds
}

enum Drag
{
    None,
    Seeker,
    LHandle,
    RHandle,
    Track,  // a track's label, slides the track
    TrimFrom, // the focused track's brackets in trim mode
    TrimTo
}

Number TRACK_HALF:  2.60; // timeline track spans -TRACK_HALF to TRACK_HALF on the menu x axis
Number TRACK_WIDTH: 2 * TRACK_HALF;
Number TOOLTIP_Y:   -1.085;
Number TOOLTIP_SIZE: 0.9;

Number HANDLE_Y_MIN:     -0.80;
Number HANDLE_Y_MAX:     -0.725;
Number HANDLE_HALF_W:    0.0375;
Number HANDLE_MIN_GAP:   0.05;

Number SEEKER_Y_MIN: -0.975;
Number SEEKER_Y_MAX: -0.825;

Number TRACK_LABEL_HALF_W: 0.05;
Number TRACK_LABEL_Y_MIN:  -1.050; // a track's label is grabbed between these
Number TRACK_LABEL_Y_MAX:  -0.980;

Number SCREEN_WIDTH:  3.65;
Number SCREEN_HEIGHT: 2.125;

Number ANIM_HIDDEN_Y: -2.9;
Number ANIM_SPEED:   0.30;

playervar Number facingX;
playervar Number facingY;

playervar Boolean timelineOpen;
playervar Boolean trackMenuOpen;
playervar Number[] timelineCtrlYPos;
playervar Number[] timelineUiYPos;

playervar Boolean animating;
playervar Boolean closing;

playervar Number dragTarget;
playervar Number slideTrack; // track whose label is hovered or slid
playervar Boolean dragNudged!; // slide was nudged with Q/E

playervar Number objectiveNext!; // objective the objective button teleports to

globalvar Number objectiveCount!;  // positions in the objective button's cycle
globalvar Number objectiveOffset!; // objectiveNext + this is the objective, -1 the payload

void InitObjectives()
{
    objectiveCount =
        [GameMode.Flashpoint, GameMode.Clash].Contains(CurrentGameMode()) ? 5
      : [GameMode.Escort, GameMode.Hybrid].Contains(CurrentGameMode()) ? 4 // the payload, then 3 objectives
      : [GameMode.Control].Contains(CurrentGameMode()) ? 3
      : [GameMode.Assault, GameMode.CaptureTheFlag].Contains(CurrentGameMode()) ? 2
      : [GameMode.Elimination, GameMode.FreezethawElimination, GameMode.Push].Contains(CurrentGameMode()) ? 1
      : 0;
    // push's real objective position is the second objective for some reason
    objectiveOffset = [GameMode.Escort, GameMode.Hybrid].Contains(CurrentGameMode()) ? -1 : CurrentGameMode() == GameMode.Push ? 1 : 0;
}

Color BluePulse():
    CustomColor(Oscillate(500, 0, 136), Oscillate(500, 153, 219), 255, 255);
Color RedPulse():
    CustomColor(Oscillate(500, 180, 255), 0, 0, 255);
Color DisabledColor():
    CustomColor(140, 140, 140, 255);

Number CursorX(Player p = local): AngleDifference(HorizontalAngleFromDirection(Facing(p)), p.facingX);
Number CursorY(Player p = local): AngleDifference(VerticalAngleFromDirection(Facing(p)), p.facingY);

Any RenderPosOf(Number x = 0, Number y = 0):
    EyePos(local) + local.orbitUi + 100 * (
        x * WorldVectorOf(Right(), local, LocalVector.Rotation)
      + y * Cross(Facing(local), WorldVectorOf(Left(), local, LocalVector.Rotation))
      + 3 * Facing(local));

Any UiPos(Number x, Number | Ui id, Number yOffset = 0): RenderPosOf(x, local.timelineUiYPos[id] + yOffset);

Number FrameToSeconds(Number f): f * delta;

Number FRAMES_PER_MINUTE: 3750;
String FormattedFrameToSec(Number f): <"<0><1>",
                                            f >= FRAMES_PER_MINUTE // minutes, and the seconds' leading 0
                                                ? <"<0>:<1>", Floor(FrameToSeconds(f) / 60), FrameToSeconds(f) % 60 < 10 ? "0" : "">
                                                : "",
                                            FrameToSeconds(f) % 60 + 0.0001>; // miliseconds, add small offset so overwatch doesnt hide decimal. this is stupid

// FormattedFrameToSec(tickK) into frameText, so server-side labels share one copy of it
playervar String frameText!;
void FrameText() playervar "frame text"
{
    frameText = FormattedFrameToSec(tickK);
}

Number ThrottleX(Player p = player): ThrottleOf(p).X;
Boolean TimelineVisible(): local.timelineOpen || local.closing;

Boolean IsDragging(Player p = local): p.dragTarget != Drag.None;
Number FrameToFraction(Number f, Player p = local): f / p.timelineView;
Number FrameToTrackX(Number f, Player p = local):   FrameToFraction(f, p) * TRACK_WIDTH - TRACK_HALF;
Number TrackXToFrame(Number x, Player p = local):   Floor(p.timelineView * NormalizedRange(Clamp(x, -TRACK_HALF, TRACK_HALF), -TRACK_HALF, TRACK_HALF));
// track labels sit between their brackets, halfway from its start (0 when before frame 0) to its end
Number TrackLabelFrame(Number t, Player p = local): (Max(TrackStart(t, p), 0) + TrackEnd(t, p)) / 2;

Number TrimStartX(Player p = local):                FrameToTrackX(p.trimStart, p);
Number TrimEndX(Player p = local):                  FrameToTrackX(p.trimEnd, p);

globalvar String txCharacter;
rule: "init unsanitized text"
{
    // unsanitized string stuff for the menu cursor, might break in future updates
    CreateDummyBot(<Hero>AllHeroes(), <Team>host, false, null, null);
    StartForcingDummyBotName(LastCreatedEntity(), "______________________________________________________________________________________________________________________________〼");
    txCharacter = StringSplit(FirstOf(LastCreatedEntity()), EmptyArray());
    StartForcingDummyBotName(LastCreatedEntity(), "______________________________________________________________________________________________________________________________ࡀ");
    txCharacter = StringSlice(StringReplace("______________________________________________________________________________________________________________________________〼", txCharacter, FirstOf(LastCreatedEntity())), 126, true);
    DestroyAllDummyBots();
}

void InitTimelinePlayer()
{
    hovered = Ctrl.None;
    confirmId = Ctrl.None;
    tipCtrl = Ctrl.None;
}

// y of each Ui item while the timeline is open. the ones read on their own have a name
Number UI_TIME_ELAPSED_Y: -1.200;
Number UI_TRACK_ENDS_Y:   -1.085; // the last one, the open animation stops once its there
Number[] TIMELINE_UI_Y_POS:
[
    -1.200,             // CurrFrame
    -1.350,             // ProgressBar
    -0.955,             // Seeker
    -0.800,             // Handles
    -0.725,             // HandleTime
    -1.1425,            // FrameMult
    UI_TIME_ELAPSED_Y,  // TimeElapsed
    UI_TRACK_ENDS_Y     // TrackEnds
];

rule: "create timeline text"
{
    CreateInWorldText(
        VisibleTo:      TimelineVisible() ? local : null,
        Header:         <"<0>", local.currFrame>,
        Position:       UiPos((CTRL_X[Ctrl.PrevFrame] + CTRL_X[Ctrl.NextFrame]) / 2, Ui.CurrFrame),
        Scale:          1,
        TextColor:      Color.White,
        Reevaluation:   InworldTextRev.VisibleToPositionAndString,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);

    CreateProgressBarInWorldText(
        VisibleTo:        TimelineVisible() ? local : null,
        Text:             "",
        Value:            FrameToFraction(local.currFrame) * 100,
        Position:         UiPos(0, Ui.ProgressBar),
        Scale:            3.2,
        ProgressBarColor: !local.recording ? Color.White : RedPulse(),
        Reevaluation:     ProgressBarWorldEvaluation.VisibleToPositionValuesAndColor,
        Clipping:         Clipping.DoNotClip);
    CreateInWorldText(
        VisibleTo:      TimelineVisible() || local.playbackActive || local.recording || local.recCount ? local : null,
        Header:         local.recCount
                            ? <"Recording in <0>", local.recCount>
                            : local.recordArmed && !ArmedRetake(local)
                            ? "Close to begin"
                            : local.recordArmed || local.recording
                                ? <"<0> <1>", local.recordArmed ? "Retake at" : "Recording:", [local.recordArmed 
                                                                                                    ? RetakeStart(local) 
                                                                                                    : local.currFrame].Map(f => FormattedFrameToSec(f)).First> // mapped so the frame isnt spelled out 4 times
                                : TimelineHasFrames(local)
                                    ? <"<0> / <1>", FormattedFrameToSec(local.currFrame), FormattedFrameToSec(local.timelineFrames)>
                                    : "Empty track",
        Position:       RenderPosOf(0, local.playbackActive || local.recording || local.recCount ? UI_TIME_ELAPSED_Y : local.timelineUiYPos[Ui.TimeElapsed]),
        Scale:          3,
        TextColor:      !local.recording && !local.recCount ? Color.White : RedPulse(),
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);

    // the playhead (s = 0) on the bar, the trim start (1) and end (2) handles above it
    for (Number s! = 0; s < 3; s++)
        CreateInWorldText(
            VisibleTo:      TimelineVisible() && TimelineHasFrames(local) && !local.recording && (Once(s) == 0 || !local.trimming) ? local : null, // the brackets are the trim handles in trim mode
            Header:         s == 0 ? "┃" : "▼",
            Position:       UiPos(FrameToTrackX([local.currFrame, local.trimStart, local.trimEnd][Once(s)]), Once(s) == 0 ? Ui.Seeker : Ui.Handles),
            Scale:          s == 0 ? 2.75 : 2,
            TextColor:      Color.White,
            Reevaluation:   InworldTextRev.VisibleToAndPosition,
            Clipping:       Clipping.DoNotClip,
            Spectators:     Spectators.VisibleNever);

    CreateInWorldText(
        VisibleTo:      TimelineVisible() && local.playMode >= PlayMode.Rewind ? local : null,
        Header:         <"x<0>", local.framesToSkip>,
        Position:       UiPos(-2.0625, Ui.FrameMult),
        Scale:          0.75,
        TextColor:      Color.White,
        Reevaluation:   InworldTextRev.VisibleToPositionAndString,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);

    cursorText = -1;
    CreateCursor();
    markerTexts = [];
    markerTracks = [];
}

globalvar Number cursorText!;

void CreateCursor() "tl - create cursor"
{
    CreateInWorldText(
        VisibleTo:      local.timelineOpen ? local : null,
        Header:         IsDragging() ? "↔" : "{0}TX {1}>".Format([txCharacter, "C0000000002DD21"]),
        Position:       Update(local.timelineOpen
                            ? RenderPosOf(
                                (local.camTurnEnd != 0 ? local.hoverX : CursorX()) + (IsDragging() ? 0 : 0.07),
                                (local.camTurnEnd != 0 ? local.hoverY : CursorY()) + (IsDragging() ? -0.07 : -0.14))
                            : null),
        TextColor:      Color.White,
        Scale:          2,
        Clipping:       Clipping.DoNotClip,
        Reevaluation:   InworldTextRev.VisibleToPositionAndString);
    DestroyInWorldText(cursorText);
    cursorText = LastTextID();
}

// the timeline, track menu and options page that were shown, the focused track and how many tracks have a marker, when the cursor was last made
playervar Number cursorShown!;
Number CursorShownNow(): timelineOpen + 2 * trackMenuOpen + 4 * OptionsShown() + 8 * focusedTrack + 128 * TrackCount();

// texts that appear after the cursor is drawn over it, so recreate the cursor once text visibilty changes or creation happens
// waits a tick so "track markers" has put the focused track's marker on top first
rule: "cursor on top"
Event.OngoingPlayer
if (cursorShown != CursorShownNow())
{
    cursorShown = CursorShownNow();

    MinWait();
    if (timelineOpen)
        CreateCursor();

    LoopIfConditionIsTrue();
}

void DestroyTexts(Number[] ids!) playervar "tl - destroy texts"
{
    for (tickI = 0; tickI < ids.Length; tickI++)
        DestroyInWorldText(ids[tickI]);
    ids = [];
}

globalvar Color[] TRACK_COLORS! = [
    CustomColor(255, 96, 96, 255),
    CustomColor(255, 176, 96, 255),
    CustomColor(255, 255, 96, 255),
    CustomColor(176, 255, 96, 255),
    CustomColor(96, 255, 96, 255),
    CustomColor(96, 255, 176, 255),
    CustomColor(96, 255, 255, 255),
    CustomColor(96, 176, 255, 255),
    CustomColor(96, 96, 255, 255),
    CustomColor(176, 96, 255, 255),
    CustomColor(255, 96, 255, 255),
    CustomColor(255, 96, 176, 255)];

globalvar Number[][] markerTexts!; // each track's label and bracket ids, while it's in markerTracks
globalvar Number[] markerTracks!;
playervar Number markerTop!; // CursorShownNow() when the focused track's marker was last put on top

// track labels and their start (s = 0) and end (s = 1) brackets on the tl bar exist while it has frames and the tl is open or closing, hidden texts cost some client performance
// starts before frame 0 shows at 0. the focused tracks are made again when the cursor is, over the other tracks, the previous ones go after
rule: "track markers"
Event.OngoingPlayer
if (player == host)
if (TRACK_IDS.IsTrueForAny(t => (trackFrames[t] > 0 && (timelineOpen || closing)) != markerTracks.Contains(t)) || markerTop != CursorShownNow())
{
    markerTop = CursorShownNow();
    for (tickJ = 0; tickJ < MAX_TRACKS; tickJ++) // DestroyTexts counts with tickI
    {
        if (trackFrames[tickJ] > 0 && (timelineOpen || closing) && (!markerTracks.Contains(tickJ) || (tickJ == focusedTrack && timelineOpen)))
        {
            Number[] ids! = [];
            CreateInWorldText(
                VisibleTo:      TimelineVisible() && local.trackFrames[Once(tickJ)] > 0 ? local : null,
                Header:         <"T<0>", tickJ + 1>,
                Position:       UiPos(FrameToTrackX(TrackLabelFrame(Once(tickJ))), Ui.TrackEnds),
                Scale:          1,
                TextColor:      local.focusedTrack == Once(tickJ)
                                    ? Color.White
                                    : local.trimming
                                        ? DisabledColor()
                                        : Once(TRACK_COLORS[tickJ]),
                Reevaluation:   InworldTextRev.VisibleToPositionAndColor,
                Clipping:       Clipping.DoNotClip,
                Spectators:     Spectators.VisibleNever);
            ids += LastTextID();

            for (tickK = 0; tickK < 2; tickK++)
            {
                CreateInWorldText(
                    VisibleTo:      TimelineVisible() && local.trackFrames[Once(tickJ)] > 0 ? local : null,
                    Header:         tickK != 1 ? "[" : "]",
                    Position:       UiPos(FrameToTrackX(Max(local.trimming && Once(tickJ) == local.focusedTrack
                                                        ? [local.trimStart, local.trimEnd][Once(tickK)]
                                                        : TrackStart(Once(tickJ)) + Once(tickK) * TrackFrames(Once(tickJ)), 0)), Ui.Seeker, 0.0080),
                    Scale:          1.90,
                    TextColor:      local.trimming
                                        ? local.focusedTrack == Once(tickJ)
                                            ? CustomColor(255, 0, 0, 255)
                                            : DisabledColor()
                                        : local.dragTarget == Drag.Track && local.slideTrack == Once(tickJ)
                                            ? OPT_HOVER_COLOR
                                            : local.focusedTrack == Once(tickJ)
                                                ? Color.White
                                                : Once(TRACK_COLORS[tickJ]),
                    Reevaluation:   InworldTextRev.VisibleToPositionAndColor,
                    Clipping:       Clipping.DoNotClip,
                    Spectators:     Spectators.VisibleNever);
                ids += LastTextID();
            }

            if (markerTracks.Contains(tickJ))
                DestroyTexts(markerTexts[tickJ]);
            else
                markerTracks += tickJ;
            markerTexts[tickJ] = ids;
        }
        else if (markerTracks.Contains(tickJ) && (trackFrames[tickJ] == 0 || !(timelineOpen || closing)))
        {
            DestroyTexts(markerTexts[tickJ]);
            markerTracks -= tickJ;
        }
    }

    MinWait();
    LoopIfConditionIsTrue();
}

// each track's start (t) and end (t + MAX_TRACKS) frame and timestamp, a start before frame 0 is 0
playervar String[] trackTimes;
playervar Number[] timeFrames; // plain, a slide changes it every tick
playervar Number[] timeTexts!;
playervar Number[] timeTracks!; // the tracks with frames when the timestamps were made

rule: "track times"
Event.OngoingPlayer
if (timelineOpen)
if (!recording)
if (TRACK_IDS.IsTrueForAny(t => Max(MarkerStart(t, player), 0) != timeFrames[t] || MarkerEnd(t, player) != timeFrames[t + MAX_TRACKS]))
{
    timeFrames = TRACK_IDS.Map(t => Max(MarkerStart(t, player), 0)).Append(TRACK_IDS.Map(t => MarkerEnd(t, player)));
    trackTimes = timeFrames.Map(f => FormattedFrameToSec(f));
    MinWait();
    LoopIfConditionIsTrue();
}

rule: "track timestamps"
Event.OngoingPlayer
if (timelineOpen)
{
    timeTracks = TRACK_IDS.Filter(t => TrackFrames(t, player) > 0);
    Number[] ids! = [];
    
    for (tickJ = 0; tickJ < 2 * MAX_TRACKS; tickJ++)
    {
        if (timeTracks.Contains(tickJ % MAX_TRACKS))
        {
            CreateInWorldText(
                VisibleTo:      !local.recording ? player : null,
                Header:         local.trackTimes[Once(tickJ)],
                Position:       UiPos(FrameToTrackX(local.timeFrames[Once(tickJ)]), Ui.TrackEnds),
                Scale:          0.65,
                TextColor:      Color.White,
                Reevaluation:   InworldTextRev.VisibleToPositionAndString,
                Clipping:       Clipping.DoNotClip,
                Spectators:     Spectators.VisibleNever);
            ids += LastTextID();
        }
    }
    DestroyTexts(timeTexts); // after, so nothing blinks
    timeTexts = ids;

    WaitUntil((!timelineOpen && AlmostEqual(timelineUiYPos.Last, ANIM_HIDDEN_Y))
        || TRACK_IDS.IsTrueForAny(t => (TrackFrames(t, player) > 0) != timeTracks.Contains(t)), 99999);

    if (!timelineOpen)
    {
        DestroyTexts(timeTexts);
        timeTexts = [];
    }
    LoopIfConditionIsTrue();
}

playervar Number trimWarnText!;
rule: "trim warning"
Event.OngoingPlayer
if (trimming)
{
    CreateInWorldText(
        VisibleTo:      player,
        Header:         !TrimChanged() 
                            ? "Trim edits are permanent, and can't be undone. Press the trim button to cancel"
                            : "Trim edits are permanent, and can't be undone. Press the trim button twice to confirm, or close the timeline to cancel",
        Position:       RenderPosOf(0, TRACK_BUDGET_Y),
        Scale:          1.2,
        TextColor:      CustomColor(255, 0, 0, 255),
        Reevaluation:   InworldTextRev.VisibleToPositionAndString,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);
    trimWarnText = LastTextID();
    CreateCursor();

    WaitUntil(!trimming, 99999);

    DestroyInWorldText(trimWarnText);
}

rule: "open menu toggle"
Event.OngoingPlayer
if (player == host) // the track storage is global, only the host edits
if (!tracksBusy) // an export reads the tracks and an import writes them, nothing may edit them
if (!HasBit(botButtons, Bit.Interact)) // not a recorded interact while playing FirstPerson, IsButtonHeld sees those holds
if (IsInteractHeld())
if (!IsJumpHeld())
if (!IsReloadHeld()) // reload + interact x2 is the recording keybind
{
    WaitIfTrue(0.2);
    hovered = Ctrl.None;

    timelineOpen = !timelineOpen;
    if (timelineOpen)
    {
        facingX = HorizontalAngleFromDirection(Facing());
        facingY = VerticalAngleFromDirection(Facing());
        SetAimSpeed(player, 10);
        CancelActions(); // stop holding abilities
        ApplyMovementState(); // also disallows buttons
    }
    else if (recordArmed)
    {
        CloseTimeline();
        recordArmed = true; // the user's close keeps an armed take, its countdown starts
    }
    else
        CloseTimeline();
}

void CloseTimeline() playervar "tl - close"
{
    recordArmed = false; // any other close cancels an armed take, it would start the countdown
    if (trimming) // only the trim button's confirmation cuts
        EndTrim();
    timelineOpen = false;
    canUseKeybinds = false;
    firstPersonKeysUp = false; // Space that started playback doesnt detach
    trackMenuOpen = false;
    optionsMenuOpen = false;
    SetAimSpeed(player, 100);
    ApplyMovementState();
}

playervar Boolean canUseKeybinds;
rule: "allow tl keybinds"
Event.OngoingPlayer
if (timelineOpen)
if (!canUseKeybinds)
if (!HasStatus(player, Status.Stunned))
if (!IsPrimaryHeld())
if (!IsSecondaryHeld())
if (!IsJumpHeld())
if (!IsCrouchHeld())
if (!IsMeleeHeld())
if (!IsAbility1Held())
if (!IsAbility2Held())
if (!IsUltimateHeld())
if (Abs(ThrottleX()) <= 0.5)
{
    WaitIfTrue(0.064);
    canUseKeybinds = true;
}

// a slide's zoom (and any other length change) eases. a recording grows the length every tick and sets the view with it
playervar Number timelineView;
rule: "timeline zoom"
Event.OngoingPlayer
if (timelineOpen)
if (timelineView != timelineFrames)
{
    timelineView = Abs(timelineView - timelineFrames) < 1 
                        ? timelineFrames 
                        : Lerp(timelineView, timelineFrames, ANIM_SPEED);
    MinWait();
    LoopIfConditionIsTrue();
}

void StepAnim() playervar "tl - anim"
{
    timelineCtrlYPos = CTRL_Y.Map((y, i) => Lerp(timelineCtrlYPos[i], closing ? ANIM_HIDDEN_Y : y, ANIM_SPEED));
    timelineUiYPos = TIMELINE_UI_Y_POS.Map((y, i) => Lerp(timelineUiYPos[i], closing ? ANIM_HIDDEN_Y : y, ANIM_SPEED));
}

rule: "open anim"
Event.OngoingPlayer
if (timelineOpen)
if (!closing)
{
    animating = true;

    while (timelineOpen && animating)
    {
        StepAnim();

        if (AlmostEqual(timelineUiYPos.Last, UI_TRACK_ENDS_Y))
            break;

        MinWait();
    }

    animating = false;
}

rule: "close anim"
Event.OngoingPlayer
if (!IsDummyBot()) // would otherwise animate every new bot's (unused) timeline for ~1s
if (!timelineOpen)
{
    WaitUntil(!animating, 1);
    closing = true;
    animating = true;

    while (animating && closing)
    {
        StepAnim();

        if (AlmostEqual(timelineUiYPos.Last, ANIM_HIDDEN_Y))
            break;

        MinWait();
    }

    animating = false;
    closing = false;
}
