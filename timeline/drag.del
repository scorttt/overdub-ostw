import "../main.del";

Number SNAP_DIST: 0.0175;

rule: "grab"
Event.OngoingPlayer
if (canUseKeybinds)
if (!recording)
if (TimelineHasFrames(player))
if (IsPrimaryHeld())
if (!IsDragging(player))
if (handleTip != Drag.None || (Abs(hoverX) < TRACK_HALF && IsInRange(hoverY, SEEKER_Y_MIN, SEEKER_Y_MAX)))
{
    if (handleTip != Drag.None)
        dragTarget = handleTip;
    else
    {
        dragTarget = Drag.Seeker;
        StopForSeek();
    }

    WaitUntil(!IsPrimaryHeld() || !timelineOpen, 99999);

    dragTarget = Drag.None;
}

rule: "drag"
Event.OngoingPlayer
if (IsPrimaryHeld())
if (IsDragging(player))
{
    tickK = -1; // frame the drag snaps to

    if (tickK == -1)
    {
        for (tickI = 0; tickI < MAX_TRACKS; tickI++)
        {
            if (TrackFrames(tickI, player) > 0 && Abs(FrameToTrackX(TrackEnd(tickI, player), player) - hoverX) < SNAP_DIST)
            {
                tickK = TrackEnd(tickI, player);
                break;
            }
        }
    }

    // a handle snapping past the other one follows the cursor instead
    if (tickK == -1 || (dragTarget == Drag.LHandle && tickK > trimEnd) || (dragTarget == Drag.RHandle && tickK < trimStart))
        tickK = TrackXToFrame(hoverX, player);

    switch (dragTarget)
    {
        case Drag.Seeker:
            currFrame = Clamp(tickK, trimStart, trimEnd);
            break;

        case Drag.LHandle:
            trimStart = Clamp(tickK, 0, trimEnd);

            if (currFrame < trimStart)
            {
                StopForSeek();
                currFrame = trimStart;
            }

            break;

        case Drag.RHandle:
            trimEnd = Clamp(tickK, trimStart, timelineFrames);

            if (currFrame > trimEnd)
            {
                StopForSeek();
                currFrame = trimEnd;
            }

            break;
    }

    MinWait();
    LoopIfConditionIsTrue();
}
